# Supabase Configuration
# Replace these placeholder values with your actual Supabase project settings
# Check your Supabase project's API settings at https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SMS Gateway Configuration for OTP Verification
# 1. Twilio (Recommended for global delivery, both Nepal +977 and India +91)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-sender-number

# 2. Sparrow SMS (Nepal #1 dedicated SMS gateway for +977)
# SPARROW_SMS_TOKEN=your-sparrow-sms-token
# SPARROW_SMS_IDENTITY=your-sparrow-sms-sender-id

# 3. Fast2SMS (India dedicated SMS gateway for +91)
# FAST2SMS_API_KEY=your-fast2sms-api-key

# 4. MSG91
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_TEMPLATE_ID=your-msg91-dlt-template-id
